rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper authorization functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    function isOwner() {
      return isAuthenticated() && (request.auth.token.role == 'owner' || request.auth.token.isVerifiedOwner == true);
    }

    function isSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isSelf(userId) || isAdmin();
    }

    // 2. Apartments collection
    match /apartments/{apartmentId} {
      allow read: if true;
      allow create: if isOwner();
      allow update, delete: if (isOwner() && resource.data.ownerId == request.auth.uid) || isAdmin();
    }

    // 3. Listings collection
    match /listings/{listingId} {
      // Public can read approved and non-hidden listings
      allow read: if resource.data.approvalStatus == 'approved' && resource.data.roomStatus != 'hidden'
                     || (isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin()));
      allow create: if isOwner() && request.resource.data.ownerId == request.auth.uid;
      allow update: if (isOwner() && resource.data.ownerId == request.auth.uid) || isAdmin();
      allow delete: if (isOwner() && resource.data.ownerId == request.auth.uid) || isAdmin();
    }

    // 4. Appointments collection
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated() &&
        (resource.data.finderId == request.auth.uid || resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.finderId == request.auth.uid;
      allow update: if isAuthenticated() &&
        (resource.data.finderId == request.auth.uid || resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // 5. Realtime Chat Rooms & Messages
    match /chat_rooms/{roomId} {
      allow read, write: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read, write: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participants;
      }
    }

    // 6. Reviews collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.finderId == request.auth.uid;
      allow update: if (isAuthenticated() && resource.data.ownerId == request.auth.uid) || isAdmin();
    }

    // 7. Violation Reports
    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update: if isAdmin();
    }

    // 8. Categories & Amenities (Reference data)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /amenities/{amenityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
